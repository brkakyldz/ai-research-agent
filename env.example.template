# ── AI News Digest Agent — environment ────────────────────────────────────────
# Copy to .env and fill in the secrets. .env is gitignored; this file is not.

# ── Secrets ───────────────────────────────────────────────────────────────────
# OpenAI: summarize + rank nodes (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tavily: enrichment only, free tier (https://app.tavily.com) — leave empty to
# disable enrichment; the pipeline then degrades to RSS + trafilatura.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-5.6-luna
# Summarize node only — bumped to gpt-5.6-terra if the M3 Turkish-quality spike
# says nano-tier is not good enough.
OPENAI_MODEL_SUMMARIZE=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=5
# Send fan-out batch size; keeps concurrent requests under the rate limit.
SUMMARIZE_BATCH_SIZE=10

# ── Digest ────────────────────────────────────────────────────────────────────
# One language per run: tr | en. The UI toggle overrides this per request.
DIGEST_LANGUAGE=tr
DIGEST_TOP_N=15
# Fuzzy-title dedupe (rapidfuzz token_set_ratio, 0-100) and its lookback window.
DEDUPE_SCORE_THRESHOLD=85
DEDUPE_LOOKBACK_HOURS=72
# Hard daily cap on Tavily credits.
TAVILY_DAILY_CAP=30
# Consecutive failures before a source auto-disables.
SOURCE_MAX_FAILURES=5

# ── Scheduling ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_HOURS=3
DIGEST_CRON_HOUR=7
DIGEST_CRON_MINUTE=0
# IANA name; all schedules are local time.
TIMEZONE=Europe/Istanbul

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container; docker-compose mounts ./data over it.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── Web ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# development | production — controls template auto-reload and error detail.
ENVIRONMENT=development
