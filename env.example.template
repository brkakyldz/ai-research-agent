# ── AI News Digest Agent — environment ────────────────────────────────────────
# Copy to .env and fill in the secrets. .env is gitignored; this file is not.

# ── Secrets ───────────────────────────────────────────────────────────────────
# OpenAI: summarize + rank nodes (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tavily: enrichment only, free tier (https://app.tavily.com) — leave empty to
# disable enrichment; the pipeline then degrades to RSS + trafilatura.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM ───────────────────────────────────────────────────────────────────────
# Since ADR 0020 these three are DEFAULTS, not settings: the confirmation on
# /runs offers a model per node at the press, and the CLI takes --model flags.
# What they decide is what a press or a command that names nothing will use.
OPENAI_MODEL=gpt-5.6-luna
# Summarize node only — bumped to gpt-5.6-terra if the M3 Turkish-quality spike
# says nano-tier is not good enough.
OPENAI_MODEL_SUMMARIZE=gpt-5.6-luna
# The grounding judge (`ainews eval judge`) only; never used by a digest run.
# Ten times the pipeline's price per token: twelve judged summaries cost about
# twice what ninety summarised ones do.
OPENAI_MODEL_JUDGE=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=5
# Send fan-out batch size; keeps concurrent requests under the rate limit.
SUMMARIZE_BATCH_SIZE=10

# ── Digest ────────────────────────────────────────────────────────────────────
# One language per run: tr | en. The UI toggle overrides this per request.
DIGEST_LANGUAGE=tr
DIGEST_TOP_N=15
# Fuzzy-title dedupe (rapidfuzz token_set_ratio, 0-100) and its lookback window.
DEDUPE_SCORE_THRESHOLD=85
DEDUPE_LOOKBACK_HOURS=72
# Hard daily cap on Tavily credits.
TAVILY_DAILY_CAP=30
# Consecutive failures before a source auto-disables.
SOURCE_MAX_FAILURES=5
# Ignore feed entries older than this. Several feeds serve their full archive.
COLLECT_MAX_AGE_DAYS=7

# ── Collection, and the advice to run ─────────────────────────────────────────
# The clock winds one job now, the feed poll. The digest is started by hand.
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_HOURS=3
# How long after a digest before /runs suggests another. Advice, not a trigger.
DIGEST_SUGGEST_AFTER_HOURS=24
# IANA name; every clock the interface draws is local time.
TIMEZONE=Europe/Istanbul

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container; docker-compose mounts ./data over it.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── Tracing (development only) ─────────────────────────────────────────────
# Off by default. Set true and start the extra container to see every prompt,
# response, duration and token count of a run:  docker compose --profile dev up
# Then open http://localhost:6006. The endpoint below is the host's view;
# docker-compose overrides it with the service name inside the network.
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# ── Web ───────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# development | production — controls template auto-reload and error detail.
ENVIRONMENT=development
