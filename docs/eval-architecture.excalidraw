      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 3,
      "text": "ainews eval rank-stability --run <id>\n--times 3",
      "originalText": "ainews eval rank-stability --run <id>\n--times 3",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
    {
      "id": "text5c9b873be078",
      "type": "text",
      "x": 344,
      "y": 1184.9,
      "width": 361.53,
      "height": 87.75,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 157413274,
      "version": 1,
      "versionNonce": 740954425,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757000000000,
      "link": null,
      "locked": false,
      "fontSize": 13.5,
      "fontFamily": 2,
      "text": "The candidate table's order is an accident of the\ndatabase. Shuffle it three ways under seed + i, call\nrank_summaries on each, then compare the orders that\ncome back: mean pairwise Kendall τ, and mean Jaccard\nof the top N.",
      "originalText": "The candidate table's order is an accident of the\ndatabase. Shuffle it three ways under seed + i, call\nrank_summaries on each, then compare the orders that\ncome back: mean pairwise Kendall τ, and mean Jaccard\nof the top N.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
    {
      "id": "textea058b0d590b",
      "type": "text",
      "x": 344,
      "y": 1277.65,
      "width": 368.48,
      "height": 52.65,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 29036651,
      "version": 1,
      "versionNonce": 814049802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757000000000,
      "link": null,
      "locked": false,
      "fontSize": 13.5,
      "fontFamily": 2,
      "text": "One EvalResult of kind rank_stability. A run that\nfell back to importance order records passed = None —\nτ over a deterministic fallback measures nothing.",
      "originalText": "One EvalResult of kind rank_stability. A run that\nfell back to importance order records passed = None —\nτ over a deterministic fallback measures nothing.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
